---
interface Props {
  frontmatter: {
    title: string;
    coverImage?: string;
    image?: {
      url: string;
      alt?:string;
    };
    bibliography?: string[];
    memos?: string[];

    paraIndent?: string;
    paraGap?: string;
  };
}

const { frontmatter } = Astro.props;
const { title, coverImage, image, bibliography = [], memos = [] } = frontmatter;

const resolvedCoverImage = coverImage ?? image?.url;
const resolvedAlt = image?.alt ?? "";

const paraIndent = frontmatter.paraIndent ?? "2ch";
const paraGap = frontmatter.paraGap ?? "1.5em";

---

<html 
  lang="ja"
  style="--cover-inline:5em; --cover-block:8em"
>
  <head>
    <meta charset="utf-8" />
    <title>{title}</title>
    <style>
      html, body {
        margin: 0;
        padding: 0;
        height: 100vh;
        overflow: hidden;
        font-family: "Noto Serif JP", "Yu Mincho", serif;


        /* background-color: black; */
        color: rgb(199, 199, 199);
      }

      
      .container {
        display: grid;
        grid-template-rows: 75vh 25vh;
        inline-size: fit-content;
      }


      .scroll-wrapper {
        visibility: hidden;
        height: 100vh;
        overflow-x: auto;
        overflow-y: hidden;
        padding-inline-start: 10vw;

        background-image: url('/images/backgrounds/pattern001.png');
        background-repeat: repeat;   
        background-position: right top; 
        background-size: auto 100%; 
      }
  
      .main-content {
        inline-size: 75vh;
        padding: 2rem;

        writing-mode: vertical-rl;
        text-orientation: mixed;

        column-gap: 2rem;
        column-fill: auto;

        overflow: visible;
        border-bottom: 2px solid #333;
      }


      .main-content p {
        text-indent: var(--para-indent, 2ch);
      }

      .main-content p + p {
        margin-block-start: var(--para-gap, 1.5em);
      }

      /* Opt-in gap */
      .main-content .gap p {
        margin-block-start: var(--para-gap, 2em);
        margin-block: var(--para-gap, 3em);
      }

      .main-content hr.para-gap {
        border: none;
        block-size: var(--para-gap, 2em);
      }

      h1 {
        margin-top: 0;
      }

      h2 {
        font-size: 1.2rem;
        margin-top: 0;
      }

      ul {
        list-style-position: inside;
        padding: 0;
        margin: 0.5rem 0;
      }

      li {
        margin: 0.5rem 0;
      }

      /* Custom text styles */
      .emphasis {
        font-weight: bold;
        color: #c00;
      }

      .gothic {
        font-family: "Noto Sans JP", "Yu Gothic", sans-serif;
      }

      .mincho {
        font-family: "Noto Serif JP", "Yu Mincho", serif;
      }

      .large {
        font-size: 1.3em;
      }

      .small-note {
        font-size: 0.9em;
        color: #666;
      }

      /* Inline icon styles */
      .inline-icon {
        width: 1em;
        height: 1em;
        display: inline-block;
        vertical-align: middle;
      }

      .inline-icon-small {
        width: 0.8em;
        height: 0.8em;
        display: inline-block;
        vertical-align: middle;
      }

      /* ONLY inline images inside text */
      .inline-icon {
        inline-size: 1em;
        block-size: 1em;
        display: inline-block;
      }


      .cover-wrapper {
        position: relative;        /* anchor for absolute title */
        inline-size: 100vh; /* Fill viewport height */
        aspect-ratio: 2 / 3;  /* Fixed visible width */

        overflow: hidden;        /* REQUIRED for cropping */
        display: block;
        margin-block-end: 7em; /* ← space before first sentence */
      }

      .cover-image {
        inline-size: 100%;
        block-size: 100%;
        object-fit: cover;
        object-position: center; 
      }

      /* Title overlay */
      .cover-title {
        position: absolute;
        z-index: 1; 

        /* Relative to cover image box */
        inset-block-start: 6%;    /* from right of cover */
        inset-inline-start: 6%;    /* from topedge */

        writing-mode: vertical-rl;
        text-orientation: mixed;

        /* Scale relative to cover size */
        font-size: clamp(1.2rem, 4vh, 3rem);
        line-height: 1.2;
        letter-spacing: 0.1em;

        color: white;
        text-shadow: 0 0 8px rgba(0,0,0,.8);

        pointer-events: none;
        /* inline stays tight */
        padding-inline: 2em;

        /* block gets breathing room */
        padding-block: 0.4em;
      }

      .cover-title::before {
        content: "";
        position: absolute;
        inset: 0;

        background: rgba(0, 0, 0, 0.8); /* 80% opacity */
        z-index: -1;

        /* Slight rounding feels book-like */
        border-radius: 0.2em;
      }

      .quote {
        writing-mode: vertical-rl;

        font-family: "Noto Sans JP", "Yu Gothic", sans-serif;
        font-size: 0.9em;
        color: #aaa;

        /* Full block indentation */
        padding-inline-start: 3ch;
        margin-inline-start: 2ch;

        /* border-inline-start: 2px solid #555; */

        /* Vertical rhythm */
        margin-block: 2em;
      }

      .figure-inline {
        margin-block: 2em;
        break-inside: avoid;

        writing-mode: vertical-rl;
      }

      .figure-inline img {
        inline-size: 8em;
        block-size: auto;
        display: block;
      }

      .figure-inline figcaption {
        margin-block-start: 0.5em;
      }

      /* Horizontal supplement text */
      .caption-horizontal {
        writing-mode: horizontal-tb;
        font-size: 0.6em;
        color: #999;
        display: inline-block;
      }

      .chapter {
        break-before: column;
        margin-block-start: 3em;
      }

      .chapter-title {
        writing-mode: vertical-rl;

        font-size: 1.0 em;
        font-weight: 600;

        /* Custom placement */
        margin-inline-start: 20ch;
        margin-block-end: 1.5em;

        letter-spacing: 0.15em;
      }

      /* Generic media block */
      .media-block {
        --media-block-size: 50%;          /* default */
        --gap: 1.2em;

        display: grid;
        grid-template-columns: var(--media-block-size) auto;
        columns-gap: var(--gap);

        writing-mode: vertical-rl;
        align-items: stretch;

        margin-block: 2em;
      }

      /* Media itself */
      .media-block .media {
        block-size: 100%;
        inline-size: 100%;
        object-fit: contain;
      }

      /* Caption or explanation */
      .media-block .caption {
        writing-mode: horizontal-tb;
        font-size: 0.9em;
        line-height: 1.6;
        color: #aaa;
      }

      /* YouTube iframe normalization */
      .media-block iframe {
        block-size: 100%;
        inline-size: 100%;
        object-fit: contain;
        aspect-ratio: 16 / 9;
        border: none;
      }

      /* Half-height split: image top, text bottom */
      .half-split {
        display: grid;
        grid-template-columns: 65% 1fr;  /* in vertical-rl, columns = top/bottom */
        column-gap: 1em;
        inline-size: 100%;
        margin-block: 2em;
        break-inside: avoid;
      }

      .half-split .half-top {
        display: flex;
        align-items: start;  /* align image to top */
        overflow: hidden;
      }

      .half-split .half-top img {
        block-size: auto;
        inline-size: 100%;
        object-fit: contain;
      }

      .half-split .half-bottom {
        overflow: visible;
        writing-mode: vertical-rl;
      }

      /* Figure and caption in half-split */
      .half-split .half-top figure {
        margin: 0;
        position: relative;
        height: 100%;
        width: 100%;
      }

      .half-split .half-top figure img {
        display: block;
        max-block-size: 80%;
        max-inline-size: 100%;
        object-fit: contain;
        margin: 0 auto;
      }

      .half-split .half-top figcaption {
        position: absolute;
        inset-block-end: 1em;
        inset-inline-start: center;
        inset-inline-end: 0;
        writing-mode: horizontal-tb !important;
        font-size: 0.85em;
        color: #999;
        text-align: center;
        padding: 0.5em;
        /* background: rgba(0, 0, 0, 0.7); */
      }


      /* #### Bottom Section Layout - Manual from markdown ####*/
        .bottom-section {
          height: 25vh;
          inline-size: 75vh;

          /* CRITICAL */
          overflow: hidden;
          contain: layout paint;

          /* break column + writing-mode inheritance */
          writing-mode: vertical-rl;

          border-top: 2px solid #333;
        }

        .bottom-section-manual {
          inline-size: 75vh;
          padding: 1rem 2rem;

          writing-mode: vertical-rl;
          text-orientation: mixed;

          overflow: hidden;
          border-top: 2px solid #333;
        }


        .bottom-section-manual h2 {
          font-size: 1.2rem;
          margin-top: 0;
        }

        .bottom-section-manual ul {
          list-style-position: inside;
          padding: 0;
          margin: 0.5rem 0;
        }

        .bottom-section-manual li {
          margin: 0.5rem 0;
        }

    </style>
  </head>
  <body>
    <div class="scroll-wrapper">
      <div class="container">
        <div class="main-content" style={`--para-indent:${paraIndent ?? "2ch"}; --para-gap:${paraGap ?? "1.5em"}`}>
          {resolvedCoverImage && (
            <div class="cover-wrapper">
              <img src={resolvedCoverImage} alt={resolvedAlt} class="cover-image" />
              <h1 class="cover-title">{title}</h1>
            </div>
          )}

          <slot />
        </div>

        <!-- Move bottom slot HERE - inside container, after main-content -->
        <div class="bottom-section-manual">
          <slot name="bottom" />
        </div>
        
      </div>
    </div>

    <script>
      window.addEventListener("load", () => {
        const scroller = document.querySelector(".scroll-wrapper") as HTMLElement | null;
        if (!scroller) return;
        scroller.scrollLeft = scroller.scrollWidth - scroller.clientWidth;
        scroller.style.visibility = "visible";
      });
    </script>
  </body>
</html>

