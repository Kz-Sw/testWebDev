---
import MainHead from '../components/MainHead.astro';

export interface Props {
  title: string;
  mainTitle?: string;
  heroMedia?: {
    type: 'image' | 'video';
    url: string;
    alt?: string;
    poster?: string;
    position?: string;
  };
}

const {
  title,
  mainTitle = "さぶろう座",
  heroMedia = {
    type: 'image',
    url: "/images/posts/post-1/post-1_hero.jpg",
    alt: "hero",
    position: "center center"
  }
} = Astro.props;
---

<html lang="ja">
  <head>
    <MainHead title={title} description="さぶろう座" />
  </head>

  <body>
    <div class="scroll-wrapper">

<!-- HERO (RIGHT SIDE) -->
      <div class="hero-section">
        {heroMedia.type === "image" && (
          <img 
            src={heroMedia.url} 
            alt={heroMedia.alt ?? mainTitle} 
            style={`object-position: ${heroMedia.position};`}
          />
        )}
        
        {heroMedia.type === "video" && (
          <video
            src={heroMedia.url}
            poster={heroMedia.poster}
            autoplay
            muted
            loop
            playsinline
            style={`object-position: ${heroMedia.position};`}
          ></video>
        )}
        
        <div class="hero-overlay">
          {mainTitle}
        </div>
      </div>

      <div class="descrip">
        <div class="descrip-text">
          <ruby>薔薇<rt>ばら</rt></ruby>の下には何がある<br/>
          三千世界の遥かむこう<br/>
          それは現か、まぼろしか<br/>
          銀河と<ruby>阿頼耶<rt>あらや</rt></ruby>の時空を巡り<br/>
          <br/>
          寒無の旅路のはじまはじまり
        </div>
      </div>

      <!-- POSTS -->
      <main class="blog-post-wrapper">
        <slot />
      </main>

    </div>
  </body>
</html>

<style>
/* RESET */
html, body {
  margin: 0;
  padding: 0;
  background: #000;
  color: white;
  font-family: 'Noto Serif JP', serif;
}

/* MAIN HORIZONTAL ENGINE */
.scroll-wrapper {
  display: flex;
  flex-direction: row-reverse;
  height: calc(100vh);
  overflow-x: auto;
  overflow-y: hidden;
}

/* HERO */
.hero-section {
  flex: 0 0 80vh;
  height: 100vh;
  position: relative;
  background: black;
}

.hero-section img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

/* VERTICAL OVERLAY TEXT */
.hero-overlay {
  position: absolute;
  top: 30%;
  right: 10%;
  transform: translateY(-50%);

  writing-mode: vertical-rl;
  text-orientation: mixed;

  font-size: 2.5rem;
  font-weight: bold;

  background: rgba(0, 100, 0, 0.7);
  padding: 1rem 0.5rem;
}

.descrip {
  display: flex;
  align-items: center;
  justify-content: center;
  margin-top: 10rem;
  flex: 0 0 60vh;
  height: 50vh;
  position: relative;
  background-color: black;
}

.descrip-text {
  writing-mode: vertical-rl;
  font-size: 1.5rem;
  text-shadow: 0 0 16px rgba(234, 255, 0, 0.4);
  filter: blur(0.5px);
  background: linear-gradient(
    to bottom left,
    rgba(8, 62, 255, 0.9),
    rgba(164, 59, 255, 0.9),
    rgba(144, 0, 0, 0.6)
  );
  -webkit-background-clip: text;
  background-clip: text;
  -webkit-text-fill-color: transparent;
  color: transparent;
}
/* POSTS STRIP */
.blog-post-wrapper {
  display: flex;
  flex-direction: row-reverse;
  gap: 0rem;
  padding: 0rem;
  align-items: stretch;
}


</style>
