---
import { buildSlug } from "../scripts/utils";
import navData from "../data/navData.js";

import type { MarkdownInstance } from "astro";
import { toKanjiDigits } from "../scripts/utils";

interface Frontmatter {
  number?: number;
  heroTitle?: string;
  category?: string;
}

type Post = MarkdownInstance<Frontmatter>;

const { prevPost, nextPost, category } = Astro.props as {
  prevPost: Post | null;
  nextPost: Post | null;
  category: string;
};

function formatLabel(post: Post | null): string {
  if (!post) return "";

  const { number, heroTitle } = post.frontmatter;

  const num = number ? toKanjiDigits(number) : "";
  const title = heroTitle ?? "";

  return num && title ? `${num}・${title}` : title;
}

//Category name to Kanji
function getCategoryName(category: string | undefined): string {
  if (!category) return "";

  const match = navData.find(
    (item) => item.path === `/${category}/`
  );

  return match?.name ?? category; // fallback to 'za' etc
}

---

<footer class="simple-vertical-footer">
  <a href={`/`} class="nav-logo" aria-label="Category Home">
  <span class="logo-text">さぶろう座</span>
  </a>

  <nav class="footer-nav">
    {prevPost && (
      <a href={`/${prevPost.frontmatter.category}/${buildSlug(prevPost)}`} class="footer-item">
        {formatLabel(prevPost)}
      </a>
    )}


    <a href={`/${category ?? ""}`} class="footer-item"aria-label="Category Home">ー{getCategoryName(category)}ー 目次
    </a>
    

    {nextPost && (
      <a href={`/${nextPost.frontmatter.category}/${buildSlug(nextPost)}`} class="footer-item">
        {formatLabel(nextPost)}
      </a>
    )}

  </nav>
</footer>

<svg width="30" height="30" viewBox="0 0 24 24">
  <defs>
    <linearGradient id="grad1" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#083eff" />
      <stop offset="50%" stop-color="#a43bff" />
      <stop offset="100%" stop-color="#900000" />
    </linearGradient>
  </defs>

  <path d="M12 3l9 8h-3v9h-12v-9h-3l9-8z" fill="currentColor" />
</svg>

<style>
.simple-vertical-footer {
  position: fixed;
  top: 0;
  left: 0;
  height: 100vh;
  width: 40px;
  writing-mode: vertical-rl;
  text-orientation: mixed;
  background: rgba(0, 0, 0, 0.95);
  color: #fff; 
  display: flex;
  align-items: center;
  justify-content: flex-start;
  z-index: 999999;
  transition: opacity 0.2s ease-out; /* Makes the fade feel premium */
  opacity: 1;
}

.nav-logo {
  text-decoration: none;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 1.5rem 0;

  z-index: 100;
  
  font-size: 1rem;
  opacity: 1;
  font-weight: 700;
  font-family: 'Noto Serif JP', serif;
  background: linear-gradient(135deg, #396eff 0%, #a855f7 50%, #c084fc 100%);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;

}

.footer-nav {
  display: flex;
  flex: auto;
  justify-content:space-evenly;
  gap: 0rem;
}



.footer-item {
  justify-content: space-between;
  color: inherit;
  text-decoration: none;
  font-size: 1.2rem;
  opacity: 0.7;
  transition: opacity,scale 0.3s ease;
  max-width: 6em;
  overflow: hidden;
  text-overflow: ellipsis;
}

.footer-item:hover {
  opacity: 1;
  scale: 1.2;
  background: linear-gradient(
    to bottom left,
    rgba(8, 62, 255, 0.9),
    rgba(164, 59, 255, 0.9),
    rgba(144, 0, 0, 0.6)
  );
  -webkit-background-clip: text;
  background-clip: text;
  -webkit-text-fill-color: transparent;
  color: transparent;
}

.footer-item:hover svg path {
  fill: url(#grad1);
}

.footer-item::after {
  content: attr(data-label);
  position: relative;
  left: 100%;   /* adjust depending on layout */
  top: 50%;
  transform: translateY(-50%);
  white-space: nowrap;

  opacity: 1;
  pointer-events: none;
  transition: opacity 0.2s ease;

  font-size: 12px;
  color: white;
}
</style>

<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    const footer = document.querySelector('.simple-vertical-footer');
    if (!footer) return;

    function onScroll() {
      const scroller = document.querySelector('.scroll-wrapper');
      if (!scroller) return;
      
      const currentScroll = scroller.scrollLeft;
      const maxScrollLeft = scroller.scrollWidth - scroller.clientWidth;
      
      // Define a fixed distance for the fade (e.g., 200px)
      // This ensures it works even if the blog is short.
      const fadeDistance = 200; 

      // If the page isn't scrollable at all, keep it visible
      if (maxScrollLeft <= 0) {
        footer.style.opacity = "1";
        footer.style.pointerEvents = "auto";
        return;
      }

      // Calculate opacity based on fixed pixel distance
      // 1 at scroll 0, fades to 0 at scroll 200
      let opacity = 1 - (currentScroll / fadeDistance);
      
      // Clamp values between 0 and 1
      opacity = Math.max(0, Math.min(1, opacity));

      footer.style.opacity = opacity;
      footer.style.pointerEvents = opacity > 0.1 ? 'auto' : 'none';
    }

    const scroller = document.querySelector('.scroll-wrapper');
    if (scroller) {
      scroller.addEventListener('scroll', onScroll, { passive: true });
      // Run once immediately to set initial state
      onScroll();
    }
  });
</script>