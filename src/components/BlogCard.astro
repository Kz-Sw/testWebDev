---
interface Props {
  heroTitle: string;
  author: string;
　heroImage: string;

  description?: string;
  pubDate?: Date;
  tags: string[];
  slug: string;
}

const { heroTitle, description, pubDate, heroImage, author, tags, slug } = Astro.props;
---

<article class="blog-card" data-tags={tags.join(',')}>
  <a href={`/posts/${slug}`} class="card-link">
    {heroImage && (
      <div class="card-image">
        <img src={heroImage} alt={heroTitle} loading="lazy" />
        <div class="image-overlay"></div>

        <div class="card-main-overlay"> 
          <div class="card-title-section-overlay">
            <h2 class="card-title vertical-text">{heroTitle}</h2>
          </div>
        </div>
        </div>

      )}
  
    </a>
</article>

<style>
  .blog-card {
    background: black;
    border-radius: 0px;
    overflow: hidden;
    box-shadow: 0 4px 20px rgba(139, 92, 246, 0.1);
    transition: all 0.3s ease;
    border: 1px solid rgba(255, 255, 255, 0.2);
    position: relative;
    height: 100%;
    width: 100%;
    max-width: 100%;
  }

  .blog-card:hover {
    box-shadow: 0 12px 40px rgba(139, 92, 246, 0.2);
    border-color: #ddd6fe;
  }

  .blog-card:hover .image-overlay {
    opacity: 0.1 !important; /* Much brighter on hover, overrides JS */
  }

  .card-link {
    display: flex;
    flex-direction: row-reverse;
    text-decoration: none;
    width: 100%;
    height: 100%;
  }

  .card-image {
    position: relative;
    overflow: hidden;
    width: 100%;
    height: 100%;
    flex-shrink: 0;
  }

  .card-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 1s ease;
  }

  .image-overlay {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: rgba(0, 0, 0, 0.6);
    opacity: 1;
    transition: opacity 0.3s ease;
  }


  .card-main-overlay {
    position: absolute;
    top: 0;
    right: 0;
    width: 100%;
    height: 100%;
    padding: 1rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    pointer-events: none;
    overflow: hidden;
  }

  .card-title-section-overlay {
    width: 30%;
    max-width: 80px;
    height: auto;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    pointer-events: auto;
    background-color: rgba(0, 0, 0, 0.8);
    border-radius: 0px;
    padding: 0.4rem;
    max-height: 85%;
    overflow: hidden;
  }

  .card-title {
    font-size: 1.2rem;
    font-weight: 600;
    color: white;
    margin: 0;
    line-height: 1.3;
    font-family: 'Noto Serif JP', serif;
    text-align: center;
    letter-spacing: 0.05em;
    writing-mode: vertical-rl;
    text-orientation: upright;
    word-break: break-word;
    overflow: hidden;
    width: 100%;
    max-width: 100%;
  }
  
  /* Hide the original card-content as it's now empty */
  .card-content {
    display: none; 
  }

   
  @media (max-width: 150px) {
    .blog-card {
      height: auto; 
    }
  
    /* Adjust main card layout for mobile */
    .card-link {
      flex-direction: column; /* Stack image and content vertically on mobile */
    }
  
    .card-image {
      width: 100%; /* Image takes full width */
      height: 160px; /* Original height on mobile  */
    }
  
    /* Mobile overlay adjustments */
    .card-main-overlay {
      position: relative; /* Revert to relative positioning on mobile */
      top: auto;
      left: auto;
      width: 100
      padding: 1rem; /* Adjust padding for mobile */
      height: auto;
      flex-direction: column; /* Stack title and description vertically on mobile */
      justify-content: center;
      align-items: center;
      pointer-events: auto;
    }
  
    .card-title-section-overlay {
      width: 100%; /* Title section takes full width */
      height: 100px; /* Fixed height for title section */
    }
  
    .card-title {
      font-size: 1.1rem; 
      writing-mode: vertical-rl; 
    }



    
  }
</style>