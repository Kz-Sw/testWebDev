---
const{title,description} = Astro.props;  
import  {Icon}  from 'astro-icon/components';
import navData from '../data/navData.js';

---
<head>
  <meta charset="UTF-8" />
  <meta name="description" content={description} />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <meta name="generator" content={Astro.generator} />

  <meta name="robots" content="index, follow" />
  <meta name="author" content="さぶろう" />

  <meta property="og:type" content="website" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />

  <meta property="twitter:card" content="summary_large_image" />
  <meta property="twitter:title" content={title} />
  <meta property="twitter:description" content={description} />

  <title>{title}</title>

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Noto+Serif+JP:wght@400;500;600;700&family=Noto+Sans+JP:wght@400;500;600;700&display=swap" rel="stylesheet">

</head>

<nav class="main-nav">
  <a href="/" class="nav-logo">
    <span class="logo-text">さぶろう座</span>
  </a>
  <div class="nav-links">
    {navData.filter(item => item.nav).map((item) => (
      <a href={item.path} class="nav-link" data-tooltip={item.tooltip}>
        {item.name}
      </a>
    ))}
  </div>
  <input type="text" class="search-box" placeholder="検索..." id="header-search-input" />
</nav>

<style>
html,
body {
  margin: 0;
  padding: 0;
  width: 100%;
  min-height: 100vh;
  font-family: 'Noto Serif JP', serif;
  background:
    radial-gradient(circle at 25% 25%, rgba(139, 92, 246, 0.1) 0%, transparent 50%),
    radial-gradient(circle at 75% 75%, rgba(168, 85, 247, 0.1) 0%, transparent 50%),
    repeating-linear-gradient(
      45deg,
      rgba(255, 255, 255, 0.02) 0px,
      rgba(255, 255, 255, 0.02) 1px,
      transparent 1px,
      transparent 20px
    ),
    repeating-linear-gradient(
      -45deg,
      rgba(255, 255, 255, 0.02) 0px,
      rgba(255, 255, 255, 0.02) 1px,
      transparent 1px,
      transparent 20px
    ),
    #000000;
  color: #ffffff;
  line-height: 1.6;
}

* {
  box-sizing: border-box;
}

.main-nav {
  position: fixed;
  left: 0;
  top: 0;
  height: 100vh;
  width: 40px;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: space-between;
  padding: 1.5rem 0;
  background: rgba(0, 0, 0, 0.95);
  backdrop-filter: blur(10px);
  border-right: 1px solid rgba(255, 255, 255, 0.1);
  box-shadow: 2px 0 20px rgba(255, 255, 255, 0.05);
  z-index: 100;
  
  text-orientation: upright;
}

.nav-logo {
  text-decoration: none;
  color: inherit;
}

.logo-text {
  font-size: 1rem;
  font-weight: 700;
  font-family: 'Noto Serif JP', serif;
  background: linear-gradient(135deg, #396eff 0%, #a855f7 50%, #c084fc 100%);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
  writing-mode: vertical-rl;
}

.nav-links {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 0.5rem;
}

.nav-link {
  position: relative;
  text-decoration: none;
  color: #ffffff;
  font-weight: 500;
  opacity: 0.7;
  font-family: 'Noto Serif JP', serif;
  transition: all 0.3s ease;
  padding: 0.75rem 0.5rem;
  border-radius: 8px;
  writing-mode: vertical-rl;
}

.nav-link:hover {
  opacity: 1;
  scale: 1.2;
  background: linear-gradient(
    to bottom left,
    rgba(8, 62, 255, 0.9),
    rgba(164, 59, 255, 0.9),
    rgba(144, 0, 0, 0.6)
  );
  -webkit-background-clip: text;
  background-clip: text;
  -webkit-text-fill-color: transparent;
  color: transparent;
}

.nav-link::after {
  content: attr(data-tooltip);
  position: absolute;
  top: 0;
  left: 50%;
  transform: translateX(80%);
  background: rgba(0, 0, 0, 0.95);
  color: #fff;
  -webkit-text-fill-color: #fff;
  padding: 8px 8px;
  border-radius: 4px;
  font-size: 0.75rem;
  white-space: nowrap;
  opacity: 0;
  pointer-events: none;
  transition: opacity 0.2s;
  z-index: 500; 
}

.nav-link:hover::after {
  opacity: 0.7;
  color: #fff;
  z-index: 500; 
}

.search-box {
  padding: 0.5rem;
  border: 1px solid rgba(255, 255, 255, 0.2);
  background: rgba(255, 255, 255, 0.05);
  color: #ffffff;
  border-radius: 8px;
  font-family: 'Noto Serif JP', serif;
  transition: all 0.3s ease;
  width: 36px;
  height: 120px;
  writing-mode: vertical-rl;
}

.search-box::placeholder {
  color: rgba(255, 255, 255, 0.5);
}

.search-box:focus {
  outline: none;
  border-color: #8b5cf6;
  background: rgba(139, 92, 246, 0.1);
  box-shadow: 0 0 12px rgba(139, 92, 246, 0.3);
}

/* True Vertical Writing Utilities */
.vertical-text {
  writing-mode: vertical-rl;
  text-orientation: upright;
  text-combine-upright: digits 2;
}

.vertical-mixed {
  writing-mode: vertical-rl;
  text-orientation: mixed;
}

.horizontal-text {
  writing-mode: vertical-rl;
}

.blog-post-horizontal-scroll-wrapper > * {
  display: inline-block;
  white-space: normal;
  vertical-align: top;
  padding: 20px;
  box-sizing: border-box;
  width: 80vw;
  height: auto;
}
</style>