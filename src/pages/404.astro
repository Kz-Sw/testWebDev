        display: "grid",
        placeItems: "center",
        textAlign: "center",
        gap: "var(--small-sm)",
    }}>
    </div>
  <h1>{pageTitle} </h1>
  <h1>迷子でしょうか</h1>
  <Link 
    href="/"
    style="secondary"
    text="家はこちら"
    />
</MainLayout>